<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinUiAutomation.GeneratedApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WinUiAuto.Windows\UiAutomation.Windows.csproj" />
    <ProjectReference Include="..\..\UiAutoLib\UiAutoLib.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyUiAutoLibDll" AfterTargets="Build">
    <ItemGroup>
      <_UiAutoLibDll Include="..\..\x64\$(Configuration)\UiAutoLib.dll"
                      Condition="Exists('..\..\x64\$(Configuration)\UiAutoLib.dll')" />
    </ItemGroup>

    <Copy SourceFiles="@(_UiAutoLibDll)"
          DestinationFiles="@(_UiAutoLibDll->'$(TargetDir)UiAutoLib.dll')"
          SkipUnchangedFiles="true" />

    <Error Condition="!Exists('$(TargetDir)UiAutoLib.dll')"
           Text="UiAutoLib.dll was not found in the output directory. Build UiAutoLib x64 $(Configuration) first." />
  </Target>
</Project>
