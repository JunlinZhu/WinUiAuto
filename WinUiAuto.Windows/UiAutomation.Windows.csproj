<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>UiAutomation.Windows</PackageId>
    <Version>0.1.0</Version>
    <Authors>UiAutomation contributors</Authors>
    <Description>Record, locate, inspect, and automate Windows UI elements using reusable UI node paths.</Description>
    <PackageTags>windows;ui-automation;uiautomation;testing;powershell</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JunlinZhu/WinUiAuto</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JunlinZhu/WinUiAuto</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="..\x64\Release\UiAutoLib.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\UiAutoLib.dll"
          Visible="false"
          Condition="Exists('..\x64\Release\UiAutoLib.dll')" />
    <None Include="..\Release\UiAutoLib.dll"
          Pack="true"
          PackagePath="runtimes\win-x86\native\UiAutoLib.dll"
          Visible="false"
          Condition="Exists('..\Release\UiAutoLib.dll')" />
  </ItemGroup>

  <Target Name="ValidateNativePackageAssets" BeforeTargets="Pack">
    <Error Condition="!Exists('..\x64\Release\UiAutoLib.dll')"
           Text="Build UiAutoLib Release|x64 before packing UiAutomation.Windows." />
    <Error Condition="!Exists('..\Release\UiAutoLib.dll')"
           Text="Build UiAutoLib Release|Win32 before packing UiAutomation.Windows." />
  </Target>

</Project>
